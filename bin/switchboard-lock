#!/usr/bin/env python3
"""The one lock that keeps it to a single switchboard.

Usage: switchboard-lock [--file FILE] take TERMINAL
       switchboard-lock [--file FILE] release
       switchboard-lock [--file FILE] show

Two switchboards would both relay decisions, both cycle orchestrators and
overwrite each other's state file. So every start path checks this file: the
switchboard skill, switchboard-health and the Orchi panel. It is JSON:

  {"terminal": "t7", "herdr": "app", "started": "2026-10-30 22:40"}

The panel reads "herdr": "app", so it is always written. The word `app` after
TERMINAL is accepted and ignored, for older copies of the switchboard skill,
which passed it.

take     record TERMINAL (a Herdr app terminal address) as the switchboard. A
         live owner stops it with exit 1 and one line saying where the
         switchboard is. A dead owner is replaced. The same owner taking it
         again keeps its start time, which is what a /switchboard resume after
         a /clear does.
release  remove the lock. No lock is fine.
show     print one line. "free: ..." when a switchboard may start, otherwise
         where the running one is.

An owner is alive while `herdr agent get <terminal>` answers, asked through
bin/herdr. agent_not_found means its terminal has gone or no longer runs Claude
Code, and so does a lock an older version wrote for a terminal Herdr pane, which
the app has never heard of. Any other failure can't say, and counts as alive,
because a second switchboard is worse than a late one: the line then gives the
command to clear the lock by hand.

A lock that can't be read counts as no lock. The file is FILE, else
$SWITCHBOARD_LOCK, else lock in the switchboard folder (<claude_dir>/switchboard,
from Orchi's settings), and is replaced whole
(temp file and rename), so the panel never reads half of one. A take holds
"<file>.guard" throughout, so two takes can't both pass the check. The time is
local "YYYY-MM-DD HH:MM", from the clock, or $SWITCHBOARD_NOW when set (tests).

Exit 0 on success, 1 when a live owner stops a take, 2 for bad arguments.
"""
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import orchi_settings  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
WRAPPER = os.path.join(HERE, "herdr")
HERDR_TIMEOUT = 30
GONE = ("agent_not_found",)
TERMINAL = re.compile(r"[A-Za-z0-9][A-Za-z0-9:_.-]*")


def default_file():
    return (os.environ.get("SWITCHBOARD_LOCK")
            or os.path.join(orchi_settings.switchboard_dir(), "lock"))


def now():
    return os.environ.get("SWITCHBOARD_NOW") or time.strftime("%Y-%m-%d %H:%M")


def read(path):
    """The lock's owner as a dict, or None for no lock or one that can't be read."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            owner = json.load(f)
    except (OSError, ValueError):
        return None
    if (not isinstance(owner, dict) or not isinstance(owner.get("terminal"), str)
            or not TERMINAL.fullmatch(owner["terminal"])):
        return None
    return owner


def write(path, owner):
    folder = os.path.dirname(os.path.abspath(path))
    os.makedirs(folder, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".lock.")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(owner, f)
        f.write("\n")
    os.replace(tmp, path)


def where(owner):
    return (f"switchboard is running in terminal {owner['terminal']}, "
            f"since {owner.get('started', 'an unknown time')}")


def unknown(owner, why):
    return (f"{where(owner)}, or was: could not check ({why}). "
            f"If it has gone, run switchboard-lock release")


def state_of(owner):
    """None when the owner is dead, else the one line saying where it is."""
    try:
        done = subprocess.run([WRAPPER, "agent", "get", owner["terminal"]], capture_output=True,
                              text=True, errors="replace", timeout=HERDR_TIMEOUT)
    except subprocess.TimeoutExpired:
        return unknown(owner, f"herdr timed out after {HERDR_TIMEOUT} s")
    except OSError as e:
        return unknown(owner, f"could not run herdr: {e}")
    if done.returncode == 0:
        return where(owner)
    # herdr prints an error as JSON on stderr.
    try:
        code = json.loads(done.stderr if done.stderr.strip() else done.stdout)["error"]["code"]
    except (ValueError, KeyError, TypeError):
        code = f"exit {done.returncode}"
    return None if code in GONE else unknown(owner, code)


def holder(path):
    """The line saying where the running switchboard is, or None when the lock is free."""
    owner = read(path)
    return state_of(owner) if owner else None


def take(path, terminal):
    """Take the lock. None when taken, else the line saying where the owner is."""
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(f"{path}.guard", "a") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        owner = read(path)
        if owner and owner["terminal"] == terminal:
            return None
        held = state_of(owner) if owner else None
        if held:
            return held
        write(path, {"terminal": terminal, "herdr": "app", "started": now()})
    return None


def release(path):
    with open(f"{path}.guard", "a") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX)
        try:
            os.remove(path)
        except FileNotFoundError:
            pass


def show(path):
    owner = read(path)
    if owner is None:
        return "free: no lock"
    held = state_of(owner)
    if held:
        return held
    return f"free: terminal {owner['terminal']} has gone"


def usage():
    print(__doc__.strip(), file=sys.stderr)
    return 2


def main(argv):
    path = default_file()
    if argv[:1] == ["--file"]:
        if len(argv) < 2:
            return usage()
        path, argv = os.path.expanduser(argv[1]), argv[2:]
    cmd, args = (argv[0], argv[1:]) if argv else (None, [])
    if cmd == "take" and len(args) in (1, 2):
        if not TERMINAL.fullmatch(args[0]) or args[1:] not in ([], ["app"]):
            return usage()
        held = take(path, args[0])
        if held:
            print(held)
            return 1
        return 0
    if cmd == "release" and not args:
        release(path)
        return 0
    if cmd == "show" and not args:
        print(show(path))
        return 0
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
