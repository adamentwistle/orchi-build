#!/usr/bin/env python3
"""Change the switchboard's state file. The switchboard's only way to write it.

Usage: switchboard-state [--file FILE] add [--run] PROJECT REPO PANE
       switchboard-state [--file FILE] pane PROJECT PANE
       switchboard-state [--file FILE] remove PROJECT
       switchboard-state [--file FILE] checkin PROJECT [PROJECT ...]
       switchboard-state [--file FILE] paused PROJECT | unpaused PROJECT
       switchboard-state [--file FILE] cycle | uncycle | show

add     watch PROJECT (REPO is its absolute path, PANE its Herdr pane id) and
        give it a check-in time. With --run, also record now as the time this
        run started: switchboard-wait then ignores a CYCLE or DONE written
        before it, which is the end of an earlier run. Use --run whenever you
        start the run ("run <project>"). Adding a watched project again
        updates its repo and pane and keeps its start unless --run is given,
        which also ends any pause.
pane    the project's orchestrator moved to PANE.
remove  stop watching PROJECT: its watching, started, check-in and paused
        lines go.
checkin set each PROJECT's check-in time to now.
paused  record that PROJECT's orchestrator has stopped safely, with the time:
        switchboard-wait and switchboard-health leave it out and the Orchi
        panel shows it as paused. unpaused takes that line off, and is fine
        on a project that isn't paused.
cycle   end the file with "CYCLE <now>", asking the health watcher to cycle
        the switchboard; uncycle takes that line off.
show    print the file.

The file is FILE, else $SWITCHBOARD_STATE, else state.md in the switchboard
folder (<claude_dir>/switchboard, from Orchi's settings), and is replaced whole on every change
(temp file and rename). A "## paused" section is written only while something
is paused, after the check-ins and before any CYCLE line, which stays last.
Readers that don't know the section skip it. Times are local "YYYY-MM-DD HH:MM", from the clock,
or $SWITCHBOARD_NOW when set (tests). Exit 0 on success, 1 for a project not
in the file (nothing written), 2 for bad arguments.
"""
import os
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import orchi_settings  # noqa: E402

SECTIONS = ("watching", "started", "check-ins", "paused")


def default_file():
    return (os.environ.get("SWITCHBOARD_STATE")
            or os.path.join(orchi_settings.switchboard_dir(), "state.md"))


def now():
    return os.environ.get("SWITCHBOARD_NOW") or time.strftime("%Y-%m-%d %H:%M")


def read(path):
    """{"watching": [[project, repo, pane]], "started": [[project, time]],
    "check-ins": [[project, time]], "paused": [[project, time]], "cycle": line or None}."""
    state = {"watching": [], "started": [], "check-ins": [], "paused": [], "cycle": None}
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = [l.strip() for l in f.read().splitlines()]
    except OSError:
        return state
    section = None
    for line in lines:
        if line.startswith("## "):
            section = line[3:].strip()
            continue
        if line.startswith("CYCLE"):
            state["cycle"] = line
            continue
        parts = line.split()
        if section == "watching" and len(parts) >= 3:
            state["watching"].append([parts[0], " ".join(parts[1:-1]), parts[-1]])
        elif section in ("started", "check-ins", "paused") and len(parts) >= 2:
            state[section].append([parts[0], " ".join(parts[1:])])
    return state


def write(path, state):
    lines = ["# switchboard state", f"updated: {now()}", "## watching"]
    lines += [" ".join(row) for row in state["watching"]]
    for section in ("started", "check-ins"):
        lines.append(f"## {section}")
        lines += [" ".join(row) for row in state[section]]
    if state["paused"]:
        lines.append("## paused")
        lines += [" ".join(row) for row in state["paused"]]
    if state["cycle"]:
        lines.append(state["cycle"])
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)), prefix=".state.")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, path)


def put(rows, key, row):
    """Replace the row for key in place, or append it."""
    for i, r in enumerate(rows):
        if r[0] == key:
            rows[i] = row
            return
    rows.append(row)


def usage():
    print(__doc__.strip(), file=sys.stderr)
    return 2


def main(argv):
    path = default_file()
    if argv[:1] == ["--file"]:
        if len(argv) < 2:
            return usage()
        path, argv = os.path.expanduser(argv[1]), argv[2:]
    if not argv:
        return usage()
    cmd, args = argv[0], argv[1:]
    run = cmd == "add" and args[:1] == ["--run"]
    if run:
        args = args[1:]
    shapes = {"add": lambda a: len(a) == 3, "pane": lambda a: len(a) == 2,
              "remove": lambda a: len(a) == 1, "checkin": lambda a: len(a) >= 1,
              "paused": lambda a: len(a) == 1, "unpaused": lambda a: len(a) == 1,
              "cycle": lambda a: not a, "uncycle": lambda a: not a, "show": lambda a: not a}
    if cmd not in shapes or not shapes[cmd](args):
        return usage()
    if cmd in ("add", "pane", "remove", "checkin", "paused", "unpaused") and any(
            not a or any(c.isspace() for c in a) for a in ([args[0]] if cmd != "checkin" else args)):
        return usage()

    if cmd == "show":
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                sys.stdout.write(f.read())
        except OSError:
            pass
        return 0

    state = read(path)
    watched = [r[0] for r in state["watching"]]
    names = args if cmd == "checkin" else args[:1]
    if cmd in ("pane", "remove", "checkin", "paused", "unpaused"):
        missing = [n for n in names if n not in watched]
        if missing:
            print(f"not watched: {' '.join(missing)}", file=sys.stderr)
            return 1

    t = now()
    if cmd == "add":
        project, repo, pane = args
        put(state["watching"], project, [project, repo, pane])
        if run:
            put(state["started"], project, [project, t])
            state["paused"] = [r for r in state["paused"] if r[0] != project]
        put(state["check-ins"], project, [project, t])
    elif cmd == "pane":
        for r in state["watching"]:
            if r[0] == args[0]:
                r[2] = args[1]
    elif cmd == "remove":
        for section in SECTIONS:
            state[section] = [r for r in state[section] if r[0] != args[0]]
    elif cmd == "checkin":
        for n in names:
            put(state["check-ins"], n, [n, t])
    elif cmd == "paused":
        put(state["paused"], args[0], [args[0], t])
    elif cmd == "unpaused":
        state["paused"] = [r for r in state["paused"] if r[0] != args[0]]
    elif cmd == "cycle":
        state["cycle"] = f"CYCLE {t}"
    elif cmd == "uncycle":
        state["cycle"] = None
    write(path, state)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
