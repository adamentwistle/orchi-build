#!/bin/sh
# herdr: Orchi's one command for Herdr. See "The herdr wrapper" in docs/setup.md.
#
# The Herdr app is the only Herdr, so every call goes to herdr-adapter, which maps it onto the app's hc.
# Nothing here reaches the real herdr, which is the wrong Herdr in an app terminal: herdr-adapter runs
# it itself, only for --help, --version and --skill.
self=$(realpath -- "$0") || exit 1
exec "${self%/*}/herdr-adapter" "$@"
