#!/usr/bin/env python3
"""Claude Code hook: a banner from the panes the user wants to hear.

Usage: pane-notify   (as a Stop and Notification hook; reads the hook's JSON on stdin)

The Herdr app plays its own sounds, so this hook adds only a macOS banner,
with terminal-notifier, from an orchestrator pane (label or title
orch-<project>) and from a normal Claude session. It asks the app which
terminal it runs in (HC_TERMINAL_ID) with `herdr pane current`, through the
bin/herdr beside it, never the herdr on PATH. It says
nothing from:

- the switchboard pane (label or title `switchboard`),
- a /fanout worker pane (label `fw-<slug>`; the label beats the title, because
  a worker's session title is whatever its task is called),
- a subagent (`agent_id` in the input) or a SubagentStop,
- headless Claude (`claude -p`, entrypoint sdk-*), which inherits the terminal
  id of whatever terminal ran it,
- outside a Herdr app terminal, or a terminal the app cannot describe (better
  silent than a worker's ping).

Stop shows "<name>: done" with the first line of the last message (or
"Claude finished"). Notification shows "<name>: needs you" for
permission_prompt and elicitation_dialog; other kinds (idle_prompt repeats a
done) are quiet. <name> is the pane's label, else its title, else its
directory's name. Always exits 0 and prints nothing.
"""
import json
import os
import shutil
import subprocess
import sys

# The wrapper beside this file, which is the Herdr app's herdr. The one on PATH is the real herdr in a session
# started by hand, and that is the wrong Herdr.
HERDR = os.path.join(os.path.dirname(os.path.realpath(__file__)), "herdr")
HERDR_TIMEOUT = 5
TITLE_MAX = 80
BODY_MAX = 120
ASKS = {"permission_prompt", "elicitation_dialog"}
NOTIFIER = "/opt/homebrew/bin/terminal-notifier"
NOTIFY_TIMEOUT = 5


def herdr(*args):
    try:
        done = subprocess.run([HERDR, *args], capture_output=True, text=True,
                              timeout=HERDR_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout if done.returncode == 0 else None


def banner(title, body):
    # A hook's PATH may lack Homebrew; PANE_NOTIFY_NOTIFIER is for the tests.
    notifier = (os.environ.get("PANE_NOTIFY_NOTIFIER") or shutil.which("terminal-notifier")
                or NOTIFIER)
    try:
        # The body goes on stdin: as -message, one starting with -, [, (, { or a
        # quote is refused, and a Markdown bullet is a common first line.
        subprocess.run([notifier, "-title", title], input=body, text=True,
                       capture_output=True, timeout=NOTIFY_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        pass


def pane_info(terminal):
    out = herdr("pane", "current", "--pane", terminal)
    try:
        return json.loads(out)["result"]["pane"]
    except (TypeError, ValueError, KeyError):
        return None


def quiet_pane(pane):
    label = pane.get("name") or ""
    title = pane.get("terminal_title") or ""
    if label:
        return label == "switchboard" or label.startswith("fw-")
    return title == "switchboard"


def name_of(pane):
    cwd = (pane.get("cwd") or "").rstrip("/")
    return pane.get("name") or pane.get("terminal_title") or os.path.basename(cwd) or "Claude"


def cut(text, limit):
    return text if len(text) <= limit else text[:limit - 3].rstrip() + "..."


def first_line(text):
    for line in (text or "").splitlines():
        if line.strip():
            return line.strip()
    return ""


def message(hook):
    """(suffix, body) for this event, or None to stay quiet."""
    event = hook.get("hook_event_name")
    if event == "Stop":
        return "done", first_line(hook.get("last_assistant_message")) or "Claude finished"
    if event == "Notification" and hook.get("notification_type") in ASKS:
        return "needs you", first_line(hook.get("message")) or "Claude needs you"
    return None


def main():
    try:
        hook = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return
    if not isinstance(hook, dict) or hook.get("agent_id"):
        return
    if os.environ.get("CLAUDE_CODE_ENTRYPOINT", "").startswith("sdk"):
        return
    terminal = os.environ.get("HC_TERMINAL_ID")
    if not terminal:
        return
    what = message(hook)
    if what is None:
        return
    pane = pane_info(terminal)
    if pane is None or quiet_pane(pane):
        return
    suffix, body = what
    title = f"{cut(name_of(pane), TITLE_MAX - len(suffix) - 2)}: {suffix}"
    banner(title, cut(body, BODY_MAX))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
