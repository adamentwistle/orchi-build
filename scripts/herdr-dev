#!/bin/zsh
# A private Herdr for testing: its own window, app home and core, apart from yours.
#   herdr-dev up <slug> [repo]     make it, run orchi from repo (default: cwd) into it, open the window, give focus back
#   herdr-dev install <slug> [repo]  run orchi into it again
#   herdr-dev run <slug> <cmd...>  run a command against it: herdr-app ..., hc ...
#   herdr-dev session <slug> [folder]  throwaway Haiku session in a new space, prints its address
#   herdr-dev shot <slug> <file> [--front]  frame of its window; --front reopens it in front first, so a window
#                                  covered by another app draws, then gives focus back (core and sessions stay)
#   herdr-dev restart <slug>       quit and reopen the window, core and sessions stay
#   herdr-dev down <slug>          end its sessions, window and core
# orchi never deletes a file it didn't put there, and keeps its own records and backups in the window's home.
# It never touches ~/.config/herdr-app or the default core. Your own app gets focus back after any open.
set -u
cmd=$1; slug=$2; shift 2
home=$HOME/.config/hd/$slug
[[ $slug == default || -z $slug ]] && { echo "bad slug"; exit 2; }
# The window, its core, every terminal in it and every command run against it use this window's own Orchi settings
# file and herdr launcher, never yours, so a session started in it runs under the profile those settings name.
inenv() { env -u CLAUDE_CODE_CHILD_SESSION -u HC_TERMINAL_SOCKET -u HC_TERMINAL_ID -u HC_SCOPE HC_SESSION="d$slug" HERDR_APP_HOME="$home" HERDR_TELEMETRY=0 ORCHI_SETTINGS="$home/orchi-settings.json" ORCHI_APP_BIN="$home/orchi-app" "$@"; }
# The launcher sessions in the window find first on PATH: the herdr wrapper of the checkout under test.
launcher() {
  local wrapper=${1:A}/bin/herdr
  mkdir -p "$home/orchi-app"
  print -r -- "#!/bin/sh"$'\n'"exec ${(qq)wrapper} \"\$@\"" > "$home/orchi-app/herdr"
  chmod +x "$home/orchi-app/herdr"
}
# orchi from the repo being tested, with its own records and backups in this window's home, never yours.
orchi() { launcher "$1"; inenv env PYTHONPATH="$1/src" ORCHI_STATE="$home/orchi-state" python3 -m orchi; }
frontid() { lsappinfo info -only bundleID "$(lsappinfo front)" | sed -n 's/.*bundleID="\(.*\)".*/\1/p' | head -1; }
openwin() {
  local f=$(frontid)
  (cd /tmp; inenv nohup $HOME/.local/bin/herdr-app >"$home/window.log" 2>&1 &)
  for i in {1..40}; do inenv herdr-app status >/dev/null 2>&1 && break; perl -e 'select(undef,undef,undef,0.25)'; done
  [[ -n $f ]] && open -b "$f" 2>/dev/null
}
case $cmd in
  up)
    repo=${1:-$PWD}; mkdir -p "$home"
    [[ -f $home/shared.json ]] || print '{"frame.welcomed":"finished"}' > "$home/shared.json"
    if [[ ! -f $home/window.json ]]; then i=$(( $(print -n $slug | cksum | cut -d" " -f1) % 8 )); print "{\"state\":\"windowed\",\"bounds\":[$((120+70*i)),$((60+45*i)),1280,820]}" > "$home/window.json"; fi
    launcher "$repo"
    openwin
    # Quiet when it works. A step that needs a terminal to answer, such as which ticket sources to read, makes orchi
    # exit 1 with everything else done, so the window still gets its layout, and the output and exit code show why.
    out=$(orchi "$repo" 2>&1); rc=$?
    (( rc )) && { print -r -- "$out" >&2; echo "orchi exited $rc" >&2; }
    inenv herdr-app do layout.switch '{"name":"orchi"}' >/dev/null
    inenv herdr-app status | grep -E '"layout"|"errors"'
    exit $rc ;;
  install) out=$(orchi "${1:-$PWD}" 2>&1); rc=$?
    (( rc )) && { print -r -- "$out" >&2; echo "install failed (exit $rc)" >&2; exit $rc; }
    print -r -- "$out" | tail -1 ;;
  run) inenv "$@" ;;
  session)
    folder=${1:-$PWD}
    # The folder goes into JSON, so it's escaped there (a quote or backslash in a path).
    args=$(python3 -I -S -c 'import json,sys; print(json.dumps({"name": "t", "folder": sys.argv[1], "argv": ["zsh", "-ic", "claude --model haiku --effort low"]}))' "$folder")
    inenv herdr-app do space.new "$args" | sed -n 's/.*"terminal": "\(.*\)".*/\1/p' ;;
  shot)
    # A covered window stops drawing, and a shot of it is an old frame. --front reopens it, which brings it in front,
    # waits for it to draw, takes the frame, then hands focus back to whatever was in front before.
    if [[ ${2:-} == --front ]]; then
      f=$(frontid)
      # A covered window can time out on the quit, so it's checked: a shot of the old window would be stale.
      inenv herdr-app do app.quit >/dev/null 2>&1
      for i in {1..40}; do inenv herdr-app status >/dev/null 2>&1 || break; perl -e 'select(undef,undef,undef,0.25)'; done
      inenv herdr-app status >/dev/null 2>&1 && { echo "the window didn't close, so no shot was taken" >&2; exit 1; }
      (cd /tmp; inenv nohup $HOME/.local/bin/herdr-app >"$home/window.log" 2>&1 &)
      for i in {1..40}; do inenv herdr-app status >/dev/null 2>&1 && break; perl -e 'select(undef,undef,undef,0.25)'; done
      inenv herdr-app status >/dev/null 2>&1 || { echo "the window didn't reopen, so no shot was taken" >&2; exit 1; }
      perl -e 'select(undef,undef,undef,3)'
      inenv herdr-app shot "$1"; rc=$?
      [[ -n $f ]] && open -b "$f" 2>/dev/null
      exit $rc
    fi
    inenv herdr-app shot "$1" ;;
  restart) inenv herdr-app do app.quit >/dev/null 2>&1; perl -e 'select(undef,undef,undef,1.5)'; openwin; inenv herdr-app status | grep -E '"errors"' ;;
  down)
    for t in $(inenv hc ls | python3 -c 'import json,sys
for t in json.load(sys.stdin)["terminals"]: print(t["address"])'); do inenv hc kill "$t" >/dev/null 2>&1; done
    inenv herdr-app do app.quit >/dev/null 2>&1; perl -e 'select(undef,undef,undef,1)'; inenv hc server stop >/dev/null 2>&1; echo down ;;
  *) echo "unknown $cmd"; exit 2 ;;
esac
