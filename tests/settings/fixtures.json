{
  "about": "Cases both settings readers must agree on: mods/<mod>/settings.js and src/orchi/settings.py. Each case gives the text of settings.json and the old Herdr-side orchi.json and linear.json (an object is written out as JSON, a string is the file's text as it is, a missing file is left out), and the values that differ from the defaults. The home is always /home/me.",
  "home": "/home/me",
  "defaults": {
    "claude_dir": null,
    "orchi_dir": "/home/me/orchi-build",
    "legwork_dir": null,
    "worker_limit": 6,
    "usage_guard_percent": 95,
    "sources": ["legwork"],
    "github": { "own_owners": [], "repos": [] },
    "linear": { "teams": [], "projects": [], "repos": {}, "legwork_projects": {} },
    "markdown": { "paths": [] }
  },
  "cases": [
    { "name": "no files", "files": {}, "expected": {} },
    { "name": "an empty settings file", "files": { "settings": "" }, "expected": {} },
    { "name": "a broken settings file", "files": { "settings": "{\"worker_limit\": 7," }, "expected": {} },
    { "name": "a settings file that is not an object", "files": { "settings": "[{\"worker_limit\": 7}]" }, "expected": {} },
    { "name": "NaN breaks the whole file", "files": { "settings": "{\"worker_limit\": 7, \"usage_guard_percent\": NaN}" }, "expected": {} },
    { "name": "Infinity breaks the whole file", "files": { "settings": "{\"worker_limit\": 7, \"usage_guard_percent\": -Infinity}" }, "expected": {} },
    {
      "name": "wrong types read as unset",
      "files": { "settings": { "claude_dir": 3, "orchi_dir": "", "legwork_dir": "   ", "worker_limit": "8", "usage_guard_percent": true, "sources": "linear", "github": [], "linear": "x", "markdown": { "paths": "a" } } },
      "expected": {}
    },
    {
      "name": "wrong types inside the groups read as unset",
      "files": { "settings": { "github": { "own_owners": "me", "repos": {} }, "linear": { "teams": "ENG", "projects": 3, "repos": [], "legwork_projects": "x" }, "markdown": { "paths": null } } },
      "expected": {}
    },
    { "name": "numbers past the top of their range", "files": { "settings": { "worker_limit": 51, "usage_guard_percent": 101 } }, "expected": {} },
    { "name": "numbers under the bottom of their range", "files": { "settings": { "worker_limit": 0, "usage_guard_percent": -3 } }, "expected": {} },
    { "name": "true is not a number", "files": { "settings": { "worker_limit": true, "usage_guard_percent": false } }, "expected": {} },
    { "name": "fractions are not whole numbers", "files": { "settings": "{\"worker_limit\": 2.5, \"usage_guard_percent\": 1e400}" }, "expected": {} },
    {
      "name": "whole numbers written as decimals count",
      "files": { "settings": "{\"worker_limit\": 7.0, \"usage_guard_percent\": 1e2}" },
      "expected": { "worker_limit": 7, "usage_guard_percent": 100 }
    },
    {
      "name": "a number too long for Python's int is out of range, and the rest of the file still counts",
      "files": { "settings": "{\"worker_limit\": , \"usage_guard_percent\": -, \"orchi_dir\": \"/x\"}" },
      "expected": { "orchi_dir": "/x" }
    },
    { "name": "the top of each range", "files": { "settings": { "worker_limit": 50, "usage_guard_percent": 100 } }, "expected": { "worker_limit": 50, "usage_guard_percent": 100 } },
    { "name": "the bottom of each range", "files": { "settings": { "worker_limit": 1, "usage_guard_percent": 1 } }, "expected": { "worker_limit": 1, "usage_guard_percent": 1 } },
    {
      "name": "every value set",
      "files": {
        "settings": {
          "claude_dir": "~/.claude-alt/",
          "orchi_dir": "/src/orchi",
          "legwork_dir": "~/tracker",
          "worker_limit": 12,
          "usage_guard_percent": 90,
          "sources": ["markdown", "Linear", " github ", "jira", "linear", 3, "legwork"],
          "github": {
            "own_owners": ["Acme-Labs", " me ", "acme-labs", ""],
            "repos": ["Acme-Labs/App", " me/dots ", "nope", "a/b/c", 3, "acme-labs/app"]
          },
          "linear": {
            "teams": [" eng ", "ops", "ENG", 4],
            "projects": ["P-12", " P-7 ", "", null, "P-12"],
            "repos": { "eng": "~/dev/app/", " ops ": "/srv/ops", "web": 3, "": "/x" },
            "legwork_projects": { "P-12": " atlas ", "P-7": "", "P-9": 5 }
          },
          "markdown": { "paths": ["~/notes/tasks.md", "~/notes/todo/", "~/notes/tasks.md", ""] }
        }
      },
      "expected": {
        "claude_dir": "/home/me/.claude-alt",
        "orchi_dir": "/src/orchi",
        "legwork_dir": "/home/me/tracker",
        "worker_limit": 12,
        "usage_guard_percent": 90,
        "sources": ["legwork", "linear", "markdown"],
        "github": { "own_owners": ["acme-labs", "me"], "repos": ["acme-labs/app", "me/dots"] },
        "linear": { "teams": ["ENG", "OPS"], "projects": ["P-12", "P-7"], "repos": { "ENG": "/home/me/dev/app", "OPS": "/srv/ops" }, "legwork_projects": { "P-12": "atlas" } },
        "markdown": { "paths": ["/home/me/notes/tasks.md", "/home/me/notes/todo"] }
      }
    },
    { "name": "legwork is a source even when the list leaves it out", "files": { "settings": { "sources": ["github"] } }, "expected": { "sources": ["legwork", "github"] } },
    {
      "name": "a source is written exactly as the schema lists it",
      "files": { "settings": { "sources": ["Linear", " github ", "MARKDOWN", "linear"] } },
      "expected": { "sources": ["legwork", "linear"] }
    },
    { "name": "an empty source list still has legwork", "files": { "settings": { "sources": [] } }, "expected": {} },
    {
      "name": "old files only",
      "files": {
        "orchi": { "workerLimit": 9 },
        "linear": { "apiKey": "fixture-key-0000", "repos": { "eng": "~/dev/app" }, "teams": [" eng ", "ops"], "legwork": { "dir": "~/legwork/", "projects": { "P-1": "atlas" } } }
      },
      "expected": {
        "worker_limit": 9,
        "legwork_dir": "/home/me/legwork",
        "linear": { "teams": ["ENG", "OPS"], "projects": [], "repos": { "ENG": "/home/me/dev/app" }, "legwork_projects": { "P-1": "atlas" } }
      }
    },
    {
      "name": "the new file wins over the old ones",
      "files": {
        "settings": { "worker_limit": 3, "legwork_dir": "/l", "linear": { "teams": [], "repos": { "OPS": "/o" }, "legwork_projects": {} } },
        "orchi": { "workerLimit": 9 },
        "linear": { "apiKey": "fixture-key-0000", "repos": { "eng": "~/dev/app" }, "teams": ["eng"], "legwork": { "dir": "~/legwork", "projects": { "P-1": "atlas" } } }
      },
      "expected": {
        "worker_limit": 3,
        "legwork_dir": "/l",
        "linear": { "teams": [], "projects": [], "repos": { "OPS": "/o" }, "legwork_projects": {} }
      }
    },
    {
      "name": "a bad new value falls back to the old one",
      "files": {
        "settings": { "worker_limit": 0, "legwork_dir": 3, "linear": { "teams": "ENG", "repos": null } },
        "orchi": { "workerLimit": 9 },
        "linear": { "repos": { "eng": "~/dev/app" }, "teams": ["eng"], "legwork": { "dir": "~/legwork", "projects": { "P-1": "atlas" } } }
      },
      "expected": {
        "worker_limit": 9,
        "legwork_dir": "/home/me/legwork",
        "linear": { "teams": ["ENG"], "projects": [], "repos": { "ENG": "/home/me/dev/app" }, "legwork_projects": { "P-1": "atlas" } }
      }
    },
    {
      "name": "a broken settings file still lets the old ones through",
      "files": { "settings": "{", "orchi": { "workerLimit": 9 }, "linear": { "teams": ["eng"] } },
      "expected": { "worker_limit": 9, "linear": { "teams": ["ENG"], "projects": [], "repos": {}, "legwork_projects": {} } }
    },
    { "name": "broken old files are ignored", "files": { "orchi": "{", "linear": "nope" }, "expected": {} },
    {
      "name": "old files with wrong types are ignored",
      "files": { "orchi": { "workerLimit": "8" }, "linear": { "teams": "ENG", "repos": [], "legwork": { "dir": 5, "projects": [] } } },
      "expected": {}
    },
    { "name": "an old worker limit out of range is ignored", "files": { "orchi": { "workerLimit": 500 }, "linear": { "legwork": "~/x" } }, "expected": {} },
    { "name": "old files that are not objects are ignored", "files": { "orchi": "[9]", "linear": "[]" }, "expected": {} },
    { "name": "the API key never comes through", "files": { "linear": { "apiKey": "fixture-key-0000" } }, "expected": {} },
    {
      "name": "null reads as unset, so an old value still counts",
      "files": { "settings": { "claude_dir": null, "worker_limit": null, "sources": null, "github": null, "linear": { "teams": null } }, "orchi": { "workerLimit": 9 } },
      "expected": { "worker_limit": 9 }
    },
    {
      "name": "odd folder strings",
      "files": { "settings": { "claude_dir": "\u001c/p", "orchi_dir": "///", "legwork_dir": " ~ ", "markdown": { "paths": ["﻿/x/", "~", "~other/x", " ~/a　"] } } },
      "expected": { "orchi_dir": "/", "legwork_dir": "/home/me", "markdown": { "paths": ["/x", "/home/me", "/home/me/a"] } }
    },
    {
      "name": "only A to Z change case, so the readers never lean on their Unicode tables",
      "files": { "settings": { "github": { "own_owners": ["\u00c0B", "\ua7ce", "\u0130X"], "repos": ["\u212a/x", "Me/Dots"] }, "linear": { "teams": ["\u00fc1", "\u0131x"], "repos": { "\u00fcng": "/u" } } } },
      "expected": {
        "github": { "own_owners": ["\u00c0b", "\ua7ce", "\u0130x"], "repos": ["me/dots"] },
        "linear": { "teams": ["\u00fc1", "\u0131X"], "projects": [], "repos": { "\u00fcNG": "/u" }, "legwork_projects": {} }
      }
    },
    {
      "name": "a relative folder or another user's ~ is not a folder",
      "files": { "settings": { "claude_dir": "profiles/work", "legwork_dir": "~other/x", "linear": { "repos": { "ENG": "dev/app" } }, "markdown": { "paths": ["notes.md", "/n.md"] } }, "linear": { "legwork": { "dir": "legwork" } } },
      "expected": { "markdown": { "paths": ["/n.md"] } }
    },
    {
      "name": "a home with a dollar sign in it",
      "home": "/home/$&me",
      "files": { "settings": { "claude_dir": "~/c" } },
      "expected": { "claude_dir": "/home/$&me/c", "orchi_dir": "/home/$&me/orchi-build" }
    },
    {
      "name": "two names for one team take the one JavaScript lists last, number-like names first",
      "files": {
        "settings": "{\"linear\": {\"repos\": {\" 1 \": \"/a\", \"1\": \"/b\", \"eng\": \"/c\", \"ENG\": \"/d\"}}}",
        "linear": "{\"repos\": {\" 2 \": \"/a\", \"2\": \"/b\"}}"
      },
      "expected": { "linear": { "teams": [], "projects": [], "repos": { "1": "/a", "ENG": "/d" }, "legwork_projects": {} } }
    },
    {
      "name": "a name too long to be an array index keeps its place",
      "files": { "settings": "{\"linear\": {\"repos\": {\"\": \"/a\", \"1\": \"/b\"}}}" },
      "expected": { "linear": { "teams": [], "projects": [], "repos": { "": "/a", "1": "/b" }, "legwork_projects": {} } }
    },
    {
      "name": "two names for one team in an old file follow the same rule",
      "files": { "linear": "{\"repos\": {\" 2 \": \"/a\", \"2\": \"/b\", \"01\": \"/z\", \"4294967295\": \"/y\", \"4294967294\": \"/x\"}}" },
      "expected": { "linear": { "teams": [], "projects": [], "repos": { "2": "/a", "01": "/z", "4294967295": "/y", "4294967294": "/x" }, "legwork_projects": {} } }
    },
    {
      "name": "a Linear project id is trimmed like every other name",
      "files": { "settings": { "linear": { "legwork_projects": { " P-12 ": " atlas ", "  ": "x" } } }, "linear": { "legwork": { "projects": { " P-1": "b" } } } },
      "expected": { "linear": { "teams": [], "projects": [], "repos": {}, "legwork_projects": { "P-12": "atlas" } } }
    },
    {
      "name": "an old Linear project id is trimmed too",
      "files": { "linear": { "legwork": { "projects": { " P-1 ": "b" } } } },
      "expected": { "linear": { "teams": [], "projects": [], "repos": {}, "legwork_projects": { "P-1": "b" } } }
    },
    {
      "name": "keys named like built-ins",
      "files": { "settings": { "linear": { "repos": { "__proto__": "/x", "constructor": "/c" }, "legwork_projects": { "__proto__": "p", "toString": "t" } } } },
      "expected": { "linear": { "teams": [], "projects": [], "repos": { "__PROTO__": "/x", "CONSTRUCTOR": "/c" }, "legwork_projects": { "__proto__": "p", "toString": "t" } } }
    }
  ]
}
